  "benchmark_queue_sizes": "16,32,48,64,96,128,192,256,384,512",
  "quick_filter_bonus": 1.0,
  "warmup_runs": 2,
  "timed_runs": 3,
  "benchmark_output": "outputs/yfcc10m_categorical.csv"
}
