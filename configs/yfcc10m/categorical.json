{
  "mode": "benchmark",
  "backend": "pq",
  "dim": 192,
  "degree": 32,
  "row_limit": 10000000,

  "graph_path": "artifacts/yfcc10m/labels/graph.bin",
  "group_path": "artifacts/yfcc10m/labels/graph.identity.groups",
  "metadata_sidecar_path": "artifacts/yfcc10m/labels/graph.metadata",
  "base_vector_path": "data/yfcc10m/base.u8bin",
  "data_label_spmat_path": "data/yfcc10m/base.spmat",
