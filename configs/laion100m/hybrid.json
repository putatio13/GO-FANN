{
  "mode": "benchmark",
  "backend": "rabitq",
  "dim": 512,
  "degree": 32,
  "row_limit": 100000000,
  "specificity_threshold": 10000,

  "graph_path": "artifacts/laion100m/labels/graph.bin",
  "group_path": "artifacts/laion100m/labels/graph.identity.groups",
  "metadata_sidecar_path": "artifacts/laion100m/labels/graph.metadata",
  "base_vector_path": "data/laion100m/base.hvecs",
  "data_label_spmat_path": "data/laion100m/base.spmat",
  "rabitq_artifact_path": "artifacts/laion100m/rabitq/rabitq.b1.bin",
  "query_vector_path": "data/laion100m/queries/hybrid/query.hvecs",
  "query_label_spmat_path": "",
  "query_manifest_jsonl_path": "data/laion100m/queries/hybrid/query_manifest.jsonl",
  "query_manifest_families": "hybrid",
  "query_manifest_operator_index_path": "data/laion100m/token_operator_index.bin",
  "query_manifest_operator_fill_mode": "literal_only",
  "base_range_fbin_path": "data/laion100m/range/base_range.fbin",
  "query_range_path": "data/laion100m/queries/hybrid/query_range.bin",
  "range_posting_index_path": "artifacts/laion100m/range/ordered_postings.bin",
  "range_graph_path": "artifacts/laion100m/range/graph.bin",
  "range_graph_group_path": "artifacts/laion100m/range/graph.identity.groups",
  "range_graph_lowfreq_index_path": "artifacts/laion100m/range/graph.lowfreq.bin",
  "range_graph_seed_sidecar_path": "artifacts/laion100m/range/graph.seed",
  "range_graph_original_label_seed_sidecar_path": "artifacts/laion100m/range/graph.orig_label.seed",
  "range_graph_metadata_sidecar_path": "artifacts/laion100m/range/graph.metadata",
  "range_graph_data_label_spmat_path": "data/laion100m/range/base.virtual.spmat",
  "range_graph_label_manifest_path": "data/laion100m/range/manifest.json",

  "full_filter": true,
  "host_service_threads": 8,
  "highfreq_rerank_threads": 32,
  "lowfreq_full_filter_mode": "post",
  "search_early_stop_mode": "adaptive",
  "rabitq_lowfreq_gpu_posting": true,
  "rabitq_request_mode": "batch_ring",
  "rabitq_posting_stream_batch_size": 8192,
  "rerank_vector_storage_mode": "mmap_fp16",
  "query_prepare_threads": 8,
  "range_posting_shortlist": 400,
  "range_posting_postfilter_shortlist_multiplier": 1,
  "rabitq_range_posting_segment_rows": 4096,
  "range_graph_hybrid_and_enabled": true,
  "range_graph_hybrid_or_enabled": true,
  "rabitq_posting_schedule": "posting_first",
  "host_reply_wait_policy": "adaptive",

  "range_posting_mode": "select",
  "range_posting_scan_threshold": 20000,
  "range_label_and_policy": "auto",
  "query_manifest_max_fuzzy_terms": 16,
  "query_manifest_fuzzy_cap_policy": "coverage_cost",
  "predicate_bias_alpha": 0.15,
  "cpu_rerank_schedule": "native",
  "highfreq_rerank_mode": "cpu",
  "highfreq_rerank_streaming": true,
  "rabitq_posting_streaming": true,

  "search_queue_size": 128,
  "search_finish_count": 10,
  "benchmark_queue_sizes": "32,40,48,64,96,128,192,256,384,512",
  "quick_filter_bonus": 1.0,
  "warmup_runs": 2,
  "timed_runs": 3,
  "benchmark_output": "outputs/laion100m_hybrid.csv"
}
